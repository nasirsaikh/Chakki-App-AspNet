@model Chakki.Web.Controllers.OrderDetailModel
@{
    var o = Model.Order;
    var hi = T.Hi();
    ViewData["Title"] = $"{o.Ref} · {o.Customer!.Name}";
    var steps = new[] { OrderStatus.Intake, OrderStatus.Grinding, OrderStatus.Ready, OrderStatus.Delivered };
    var idx = Array.IndexOf(steps, o.Status);
    var floor = User.IsInRole("Owner") || User.IsInRole("Manager") || User.IsInRole("Operator");
    string inv(decimal d) => d.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    var hasTax = o.TaxTotal > 0;
}
@section Actions {
  <partial name="_OrderStatus" model="o.Status" />
  <partial name="_PaymentState" model="o.PaymentState" />
}
@if (o.Status == OrderStatus.Cancelled)
{
  <div class="alert alert-secondary"><i class="bi bi-x-circle" aria-hidden="true"></i> <div><strong>@T["Cancelled"]</strong> @(o.CancelledAt is { } ca ? Fmt.Date(ca) : "")@if (!string.IsNullOrEmpty(o.CancelReason)) { <text> · @o.CancelReason</text> }</div></div>
}
@if (o.Status != OrderStatus.Cancelled)
{
  <div class="ca-steps" aria-label="@T["Progress"]">
    @for (var i = 0; i < steps.Length; i++)
    {
      <span class="@(i < idx ? "done" : i == idx ? "current" : "")">@T[steps[i] switch { OrderStatus.Intake => "Received", OrderStatus.Grinding => "Grinding", OrderStatus.Ready => "Ready", _ => "Delivered" }]</span>
    }
  </div>
}
<div class="row g-3">
  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-body">
        <dl class="ca-summary">
          <div><dt>@T["Customer"]</dt><dd><a href="/customers/@o.CustomerId">@o.Customer.Name</a></dd></div>
          <div><dt>@T["Bill total"]</dt><dd>@Fmt.Rs(o.Total)</dd></div>
          <div><dt>@T["Forgiven"]</dt><dd>@Fmt.Rs(o.Forgiven)</dd></div>
          <div><dt>@T["Paid"]</dt><dd>@Fmt.Rs(o.Paid)</dd></div>
          <div><dt>@T["Outstanding"]</dt><dd class="@(o.Outstanding > 0 ? "text-danger" : "")">@(o.BilledAt == null ? T["Not billed"].Value : Fmt.Rs(o.Outstanding))</dd></div>
          <div><dt>@T["Received on"]</dt><dd>@Fmt.Date(o.CreatedAt)</dd></div>
        </dl>
        @if (!string.IsNullOrEmpty(o.Notes)) { <p class="mt-2 mb-0 text-body-secondary">@o.Notes</p> }
      </div>
    </div>
    <div class="card mb-3">
      <div class="card-header"><h2 class="card-title">@T["Grain and service"]</h2></div>
      <div class="ca-table-wrap">
        <table class="table" data-ca-no-filter>
          <thead><tr><th>@T["Service"]</th><th class="num">@T["Weight"]</th><th class="num">@T["Rate"]</th><th class="num">@T["Amount"]</th>@if (hasTax) {<th class="num">@T["Tax"]</th>}<th>@T["Status"]</th></tr></thead>
          <tbody>
          @foreach (var l in o.Lines.OrderBy(l => l.Id))
          {
            <tr>
              <td>@(hi && l.RateCard?.ServiceHi != null ? l.RateCard.ServiceHi : l.RateCard?.Label)@if (l.OverrideReason != null) { <br><small class="text-body-secondary"><i class="bi bi-pencil" aria-hidden="true"></i> @T["System rate"] @Fmt.Rs(l.SystemRate) · @l.OverrideReason</small> }</td>
              <td class="num">@Fmt.Qty(l.WeightKg) kg</td>
              <td class="num">@Fmt.Rs(l.AppliedRate)</td>
              <td class="num fw-semibold">@Fmt.Rs(l.LineTotal)</td>
              @if (hasTax) {<td class="num"><small>@(l.TaxAmount > 0 ? $"{l.TaxName} {l.TaxPercent:0.##}% · {Fmt.Rs(l.TaxAmount)}" : "—")</small></td>}
              <td>
                <div class="ca-line-status">
                  <span class="ca-pill @(l.Status switch { LineStatus.Done => "ca-pill-success", LineStatus.Grinding => "ca-pill-primary", _ => "ca-pill-info" })">@T[l.Status switch { LineStatus.Done => "Done", LineStatus.Grinding => "Grinding", _ => "Waiting" }]</span>
                  @if (floor && o.Status is not (OrderStatus.Delivered or OrderStatus.Cancelled))
                  {
                    @if (l.Status == LineStatus.Waiting)
                    {
                      <form asp-antiforgery="true" method="post" action="/orders/@o.Id/lines/@l.Id"><input type="hidden" name="to" value="Grinding"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-play-fill" aria-hidden="true"></i> @T["Start"]</button></form>
                      <form asp-antiforgery="true" method="post" action="/orders/@o.Id/lines/@l.Id"><input type="hidden" name="to" value="Done"><button class="btn btn-sm btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> @T["Done"]</button></form>
                    }
                    else if (l.Status == LineStatus.Grinding)
                    {
                      <form asp-antiforgery="true" method="post" action="/orders/@o.Id/lines/@l.Id"><input type="hidden" name="to" value="Done"><button class="btn btn-sm btn-primary"><i class="bi bi-check2" aria-hidden="true"></i> @T["Done"]</button></form>
                      <form asp-antiforgery="true" method="post" action="/orders/@o.Id/lines/@l.Id" data-ca-confirm="@T["Grinding not started yet?"]"><input type="hidden" name="to" value="Waiting"><button class="btn btn-sm btn-link text-body-secondary px-1" title="@T["Undo"]" aria-label="@T["Undo"]"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button></form>
                    }
                    else
                    {
                      <form asp-antiforgery="true" method="post" action="/orders/@o.Id/lines/@l.Id" data-ca-confirm="@T["Mark this as not done?"]"><input type="hidden" name="to" value="Grinding"><button class="btn btn-sm btn-link text-body-secondary px-1" title="@T["Undo"]" aria-label="@T["Undo"]"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button></form>
                    }
                  }
                </div>
              </td>
            </tr>
          }
          </tbody>
          <tfoot>
            @if (hasTax)
            {
              <tr><td colspan="3">@T["Taxable value"]</td><td class="num">@Fmt.Rs(o.Total - o.TaxTotal)</td><td colspan="2"></td></tr>
              @foreach (var g in o.Lines.Where(l => l.TaxAmount > 0).GroupBy(l => (l.TaxName, l.TaxPercent)))
              {
                var tax = g.Sum(l => l.TaxAmount);
                var rate = Model.Rates.FirstOrDefault(r => r.Id == g.First().RateCardId)?.TaxRate;
                if (rate is { SplitInHalves: true })
                {
                  var (a, b) = Chakki.Web.Services.Taxes.Halves(tax);
                  <tr><td colspan="3">@(rate.HalfLabelA ?? "A") @((g.Key.TaxPercent / 2).ToString("0.##"))%</td><td class="num">@Fmt.Rs(a)</td><td colspan="2"></td></tr>
                  <tr><td colspan="3">@(rate.HalfLabelB ?? "B") @((g.Key.TaxPercent / 2).ToString("0.##"))%</td><td class="num">@Fmt.Rs(b)</td><td colspan="2"></td></tr>
                }
                else
                {
                  <tr><td colspan="3">@g.Key.TaxName @g.Key.TaxPercent.ToString("0.##")%</td><td class="num">@Fmt.Rs(tax)</td><td colspan="2"></td></tr>
                }
              }
            }
            <tr class="fw-semibold"><td colspan="3">@T["Total"] · @Fmt.Qty(o.Lines.Sum(l => l.WeightKg)) kg</td><td class="num">@Fmt.Rs(o.Total)</td><td colspan="@(hasTax ? 2 : 1)"><small class="text-body-secondary">@o.Lines.Count(l => l.Status == LineStatus.Done) / @o.Lines.Count @T["done"]</small></td></tr>
          </tfoot>
        </table>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><h2 class="card-title">@T["Payments"]</h2></div>
      @if (o.Payments.Count == 0) { <div class="ca-empty">@T["No payments yet."]</div> }
      else
      {
        <div class="ca-table-wrap"><table class="table">
          <thead><tr><th>@T["Method"]</th><th class="num">@T["Amount"]</th><th>@T["Status"]</th><th>@T["Reference"]</th><th>@T["Date"]</th></tr></thead>
          <tbody>
          @foreach (var p in o.Payments.OrderByDescending(p => p.Id))
          {
            <tr><td>@T[p.Method.ToString()]</td><td class="num">@Fmt.Rs(p.Amount)</td>
              <td><span class="ca-pill @(p.Status == SettlementStatus.Settled ? "ca-pill-success" : p.Status == SettlementStatus.Pending ? "ca-pill-warning" : "")">@T[p.Status.ToString()]</span></td>
              <td>@if (p.Status == SettlementStatus.Pending && p.Method is PaymentMethod.UpiQr or PaymentMethod.Card) { <a href="/pay/@p.Reference">@T["Open payment screen"]</a> } else { <small class="text-body-secondary">@(p.ProviderPaymentId ?? p.Reference[..Math.Min(12, p.Reference.Length)])</small> }</td>
              <td>@Fmt.Date(p.SettledAt ?? p.CreatedAt)</td></tr>
          }
          </tbody>
        </table></div>
      }
    </div>
  </div>

  <div class="col-lg-5">
    @if (floor && o.Status != OrderStatus.Cancelled)
    {
      <div class="card mb-3">
        <div class="card-header"><h2 class="card-title">@T["Next step"]</h2></div>
        <div class="card-body d-flex flex-wrap gap-2">
          @if (o.Status == OrderStatus.Intake)
          {
            <form asp-antiforgery="true" method="post" action="/orders/@o.Id/status"><input type="hidden" name="to" value="Grinding"><button class="btn btn-primary"><i class="bi bi-play-fill" aria-hidden="true"></i> @T["Start grinding"]</button></form>
          }
          else if (o.Status == OrderStatus.Grinding)
          {
            <form asp-antiforgery="true" method="post" action="/orders/@o.Id/status"><input type="hidden" name="to" value="Ready"><button class="btn btn-primary"><i class="bi bi-check2-circle" aria-hidden="true"></i> @T["Mark ready"]</button></form>
          }
          else if (o.Status == OrderStatus.Ready)
          {
            <form asp-antiforgery="true" method="post" action="/orders/@o.Id/status"><input type="hidden" name="to" value="Delivered"><button class="btn @(o.BilledAt != null ? "btn-primary" : "btn-outline-secondary")"><i class="bi bi-truck" aria-hidden="true"></i> @T["Hand over to customer"]</button></form>
          }
          else { <p class="mb-0 text-body-secondary">@T["Delivered on"] @Fmt.Date(o.DeliveredAt ?? o.CreatedAt).</p> }
        </div>
      </div>

      <details class="card mb-3 ca-corrections">
        <summary class="card-header"><h2 class="card-title"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> @T["Fix a mistake or cancel"]</h2></summary>
        <div class="card-body">
          @if (o.Status is OrderStatus.Grinding or OrderStatus.Ready or OrderStatus.Delivered)
          {
            var backTo = o.Status switch { OrderStatus.Delivered => "Ready", OrderStatus.Ready => "Grinding", _ => "Received" };
            <form asp-antiforgery="true" method="post" action="/orders/@o.Id/back" class="mb-3">
              <label class="form-label" for="back-reason">@T["Go back to \"{0}\"", T[backTo]]</label>
              <div class="input-group"><input class="form-control" id="back-reason" name="reason" required maxlength="200" placeholder="@T["Why? e.g. marked done by mistake"]"><button class="btn btn-outline-secondary" type="submit">@T["Go back"]</button></div>
              <div class="form-text">@T["Each grain can also be undone on its own in the list."]</div>
            </form>
          }
          @if (o.BilledAt != null && o.Paid == 0 && (User.IsInRole("Owner") || User.IsInRole("Manager")))
          {
            <form asp-antiforgery="true" method="post" action="/orders/@o.Id/unbill" class="mb-3">
              <label class="form-label" for="unbill-reason">@T["Remove the bill"]</label>
              <div class="input-group"><input class="form-control" id="unbill-reason" name="reason" required maxlength="200" placeholder="@T["Why? e.g. wrong weight"]"><button class="btn btn-outline-secondary" type="submit">@T["Remove bill"]</button></div>
              <div class="form-text">@T["The bill entry is reversed in the books (not deleted). Possible only before any money is received."]</div>
            </form>
          }
          @if (o.Status != OrderStatus.Delivered && o.Paid == 0)
          {
            <form asp-antiforgery="true" method="post" action="/orders/@o.Id/cancel" data-ca-confirm="@T["Cancel this order?"]">
              <label class="form-label" for="cancel-reason">@T["Cancel the order"]</label>
              <div class="ca-chips mb-2">
                @foreach (var r in new[] { "Customer left / went to another chakki", "Duplicate entry", "Wrong entry" }) { <button class="btn btn-sm btn-outline-secondary" type="button" data-ca-fill="#cancel-reason" data-value="@T[r]">@T[r]</button> }
              </div>
              <div class="input-group"><input class="form-control" id="cancel-reason" name="reason" required maxlength="200" placeholder="@T["Reason"]"><button class="btn btn-outline-danger" type="submit">@T["Cancel order"]</button></div>
              <div class="form-text">@T["The record is kept with the reason; a bill with no money on it is reversed automatically."]</div>
            </form>
          }
          else if (o.Paid > 0 && o.Status != OrderStatus.Delivered)
          {
            <p class="small text-body-secondary mb-0">@T["Money has been received on this order, so it cannot be cancelled here."]</p>
          }
        </div>
      </details>
      @if (o.BilledAt == null)
      {
        <div class="card mb-3">
          <div class="card-header"><h2 class="card-title">@T["Bill this order"]</h2></div>
          <div class="card-body">
            <form asp-antiforgery="true" method="post" action="/orders/@o.Id/bill">
              <div class="ca-total-bar mb-3"><span>@T["Bill total"]</span><strong>@Fmt.Rs(o.Total)</strong></div>
              <div class="row g-2">
                <div class="col-6"><label class="form-label" for="forgiven">@T["Forgive (₹)"]</label><input class="form-control" id="forgiven" name="forgiven" type="number" step="0.01" min="0" max="@inv(o.Total)" value="0" inputmode="decimal"><div class="form-text">@T["Round-off or goodwill; never added to Udhaar."]</div></div>
                <div class="col-6"><label class="form-label" for="paidNow">@T["Cash paid now (₹)"]</label><input class="form-control" id="paidNow" name="paidNow" type="number" step="0.01" min="0" max="@inv(o.Total)" inputmode="decimal"><div class="form-text">@T["Leave empty if the customer pays later (Udhaar) or by UPI."]</div></div>
              </div>
              <div class="ca-form-actions"><button class="btn btn-primary" type="submit"><i class="bi bi-receipt" aria-hidden="true"></i> @T["Save bill"]</button></div>
            </form>
          </div>
        </div>
      }
      @if (o.BilledAt != null && o.Outstanding > 0 && Model.BuybackItems.Count > 0)
      {
        <div class="card mb-3">
          <div class="card-header"><h2 class="card-title"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> @T["Buyback against this bill"]</h2></div>
          <div class="card-body">
            <p class="text-body-secondary small">@T["The customer sells by-product (e.g. Khal) to you. Its value first pays this bill; anything left over is returned to the customer in cash."]</p>
            <form asp-antiforgery="true" method="post" action="/buyback" data-ca-buyback data-outstanding="@inv(o.Outstanding)">
              <input type="hidden" name="orderId" value="@o.Id"><input type="hidden" name="customerId" value="@o.CustomerId"><input type="hidden" name="fromOrder" value="true">
              <div class="row g-2">
                <div class="col-12"><label class="form-label" for="bb-item">@T["Item"]</label>
                  <select class="form-select" id="bb-item" name="itemId" required>@foreach (var i in Model.BuybackItems) { <option value="@i.Id" data-rate="@inv(i.BuybackRate)">@Fmt.Name(i) — @Fmt.Rs(i.BuybackRate)/@i.Unit</option> }</select></div>
                <div class="col-6"><label class="form-label" for="bb-qty">@T["Quantity"]</label><input class="form-control" id="bb-qty" name="quantity" type="number" step="0.01" min="0.01" inputmode="decimal" required data-ca-bb-qty></div>
                <div class="col-6"><label class="form-label" for="bb-rate">@T["Rate ₹"]</label><input class="form-control" id="bb-rate" name="rate" type="number" step="0.01" min="0" inputmode="decimal" data-ca-bb-rate></div>
                <div class="col-12 d-none" data-ca-bb-reason-wrap><label class="form-label" for="bb-reason">@T["Reason for rate change"]</label><input class="form-control" id="bb-reason" name="reason" maxlength="200"></div>
              </div>
              <dl class="ca-calc mt-3">
                <div><dt>@T["Buyback value"]</dt><dd data-ca-bb-value>₹0.00</dd></div>
                <div><dt>@T["Adjusted against bill"]</dt><dd data-ca-bb-fee>₹0.00</dd></div>
                <div><dt>@T["Bill still due"]</dt><dd data-ca-bb-due>@Fmt.Rs(o.Outstanding)</dd></div>
                <div class="ca-calc-total"><dt>@T["Return to customer"]</dt><dd data-ca-bb-cash>₹0.00</dd></div>
              </dl>
              <div class="ca-form-actions"><button class="btn btn-primary" type="submit"><i class="bi bi-check2" aria-hidden="true"></i> @T["Save buyback"]</button></div>
            </form>
          </div>
        </div>
      }
      @if (Model.Buybacks.Count > 0)
      {
        <div class="card mb-3">
          <div class="card-header"><h2 class="card-title">@T["Buyback"]</h2></div>
          <ul class="list-group list-group-flush">
            @foreach (var b in Model.Buybacks)
            {
              <li class="list-group-item d-flex justify-content-between gap-2"><span>@Fmt.Qty(b.Quantity) @b.Item?.Unit @Fmt.Name(b.Item) × @Fmt.Rs(b.AppliedRate) = <strong>@Fmt.Rs(b.Value)</strong></span>
                <small class="text-end">@T["Adjusted"] @Fmt.Rs(b.FeeAdjusted)<br>@T["Returned"] @Fmt.Rs(b.CashPaid)</small></li>
            }
          </ul>
        </div>
      }
      @if (o.BilledAt != null && o.Outstanding > 0)
      {
        <div class="card mb-3">
          <div class="card-header"><h2 class="card-title">@T["Take payment"] · @Fmt.Rs(o.Outstanding)</h2></div>
          <div class="card-body">
            <form asp-antiforgery="true" method="post" action="/orders/@o.Id/cash" class="mb-3">
              <label class="form-label" for="cash-amount"><i class="bi bi-cash" aria-hidden="true"></i> @T["Cash"]</label>
              <div class="input-group"><span class="input-group-text">₹</span><input class="form-control" id="cash-amount" name="amount" type="number" step="0.01" min="0.01" max="@inv(o.Outstanding)" value="@inv(o.Outstanding)" inputmode="decimal" required><button class="btn btn-primary" type="submit">@T["Record cash"]</button></div>
            </form>
            @if (Model.Gateways.Count == 0)
            {
              <div class="alert alert-info mb-0"><i class="bi bi-info-circle" aria-hidden="true"></i> <div>@T["To accept UPI QR or card, add your UPI ID or Razorpay keys in"] <a href="/settings/payments">@T["Settings → Payments"]</a>.</div></div>
            }
            else
            {
              <form asp-antiforgery="true" method="post" action="/orders/@o.Id/online">
                <label class="form-label"><i class="bi bi-qr-code" aria-hidden="true"></i> @T["UPI QR or card"]</label>
                <div class="row g-2">
                  <div class="col-sm-6"><select class="form-select" name="gatewayId" aria-label="@T["Gateway"]">@foreach (var g in Model.Gateways) { <option value="@g.Id">@g.Name</option> }</select></div>
                  <div class="col-sm-6"><select class="form-select" name="method" aria-label="@T["Method"]"><option value="UpiQr">@T["UPI QR"]</option><option value="Card">@T["Card / UPI app (Razorpay)"]</option></select></div>
                  <div class="col-12"><div class="input-group"><span class="input-group-text">₹</span><input class="form-control" name="amount" type="number" step="0.01" min="1" max="@inv(o.Outstanding)" value="@inv(o.Outstanding)" inputmode="decimal" required aria-label="@T["Amount"]"><button class="btn btn-outline-primary" type="submit">@T["Show QR / pay link"]</button></div></div>
                </div>
              </form>
            }
          </div>
        </div>
      }
    }
  </div>
</div>
