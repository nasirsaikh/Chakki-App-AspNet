@model List<Employee>
@{ ViewData["Title"] = T["Employees"].Value; ViewData["Lead"] = T["Monthly staff and daily-wage workers."].Value; }
<div class="row g-3">
  <div class="col-lg-8"><div class="card">
    @if (Model.Count == 0) { <div class="ca-empty"><i class="bi bi-person-badge"></i>@T["No employees yet."]</div> }
    else
    {
      <div class="ca-table-wrap"><table class="table">
        <thead><tr><th>@T["Name"]</th><th>@T["Role"]</th><th>@T["Phone"]</th><th>@T["Wage"]</th><th>@T["Joined"]</th><th>@T["Status"]</th></tr></thead>
        <tbody>@foreach (var e in Model) { <tr><td>@e.Name</td><td>@e.Role</td><td>@e.Phone</td><td>@Fmt.Rs(e.WageRate) / @(e.WageType == WageType.Daily ? T["day"] : T["month"])</td><td>@Fmt.Date(e.JoinedOn)</td><td><span class="ca-pill @(e.IsActive ? "ca-pill-success" : "")">@(e.IsActive ? T["Active"] : T["Left"])</span></td></tr> }</tbody>
      </table></div>
    }
  </div></div>
  <div class="col-lg-4"><div class="card"><div class="card-header"><h2 class="card-title">@T["Add or edit employee"]</h2></div><div class="card-body">
    <form asp-antiforgery="true" method="post" action="/employees/save">
      <label class="form-label" for="eid">@T["Employee"]</label><select class="form-select mb-2" id="eid" name="id"><option value="0">@T["— New employee —"]</option>@foreach (var e in Model) { <option value="@e.Id">@e.Name</option> }</select>
      <label class="form-label" for="en">@T["Name"]</label><input class="form-control mb-2" id="en" name="name" required maxlength="120">
      <div class="row g-2 mb-2"><div class="col-6"><label class="form-label" for="er">@T["Role"]</label><input class="form-control" id="er" name="role" maxlength="60"></div><div class="col-6"><label class="form-label" for="ep">@T["Phone"]</label><input class="form-control" id="ep" name="phone" inputmode="tel"></div></div>
      <div class="row g-2 mb-2"><div class="col-6"><label class="form-label" for="ewt">@T["Wage type"]</label><select class="form-select" id="ewt" name="wageType"><option value="Daily">@T["Daily wage"]</option><option value="Monthly">@T["Monthly salary"]</option></select></div>
        <div class="col-6"><label class="form-label" for="ewr">@T["Wage ₹"]</label><input class="form-control" id="ewr" name="wageRate" type="number" step="0.01" min="0" required inputmode="decimal"></div></div>
      <label class="form-label" for="ej">@T["Joined on"]</label><input class="form-control mb-2" id="ej" name="joinedOn" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")">
      <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="ea" name="isActive" value="true" checked><label class="form-check-label" for="ea">@T["Active"]</label></div>
      <button class="btn btn-primary w-100">@T["Save"]</button>
    </form>
  </div></div></div>
</div>
