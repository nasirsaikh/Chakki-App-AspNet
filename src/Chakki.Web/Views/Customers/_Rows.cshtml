@model Chakki.Web.Controllers.CustomerListModel
@if (Model.Rows.Count == 0) { <div class="ca-empty"><i class="bi bi-people"></i>@T["No customers found."]</div> }
else
{
  <div class="ca-table-wrap"><table class="table table-hover">
    <thead><tr><th>@T["Name"]</th><th>@T["Village"]</th><th>@T["Phone"]</th><th>@T["Type"]</th><th class="num">@T["Orders"]</th><th class="num">@T["Udhaar"]</th></tr></thead>
    <tbody>
    @foreach (var r in Model.Rows)
    {
      <tr><td><a href="/customers/@r.Customer.Id">@r.Customer.Name</a></td><td>@r.Customer.Village</td><td>@r.Customer.Phone</td>
        <td><span class="ca-pill @(r.Customer.Kind == CustomerKind.Permanent ? "ca-pill-primary" : "")">@T[r.Customer.Kind.ToString()]</span></td>
        <td class="num">@r.Orders</td><td class="num @(r.Udhaar > 0 ? "text-danger fw-semibold" : "")">@Fmt.Rs(r.Udhaar)</td></tr>
    }
    </tbody>
  </table></div>
}
