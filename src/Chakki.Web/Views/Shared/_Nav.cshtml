@using System.Security.Claims
@using Chakki.Web.Tenancy
@{
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    bool Active(string href) => href == "/" ? path == "/" : path.StartsWith(href);
    var sections = Chakki.Web.Infrastructure.NavMenu.For(User);
}
<aside class="offcanvas offcanvas-start ca-nav" tabindex="-1" id="ca-nav" aria-labelledby="ca-nav-title" data-bs-theme="dark">
  <div class="offcanvas-header">
    <a class="ca-nav-brand" href="/" id="ca-nav-title">
      <span class="ca-brand-mark" aria-hidden="true"><i class="bi bi-gear-wide-connected"></i></span>
      <span>
        <strong>@(User.FindFirstValue(TenantClaims.OrganizationName) ?? T["Chakki ERP"])</strong>
        <small>@User.FindFirstValue(TenantClaims.FullName)</small>
      </span>
    </a>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@T["Close menu"]"></button>
  </div>
  <div class="offcanvas-body">
    <nav aria-label="@T["Modules"]">
      @foreach (var section in sections)
      {
        var visible = section.Items.Where(i => !Chakki.Web.Infrastructure.NavMenu.MenuOnly.Contains(i.Href)).ToList();
        if (visible.Count == 0) { continue; }
        <div class="ca-nav-header">@T[section.Title]</div>
        <ul class="ca-nav-list">
          @foreach (var item in visible)
          {
            <li><a class="@(Active(item.Href) ? "active" : "")" href="@item.Href" aria-current="@(Active(item.Href) ? "page" : null)" data-ca-nav-link><i class="bi @item.Icon" aria-hidden="true"></i><span>@T[item.Label]</span></a></li>
          }
        </ul>
      }
    </nav>
  </div>
</aside>
