@model List<Sale>
@{ ViewData["Title"] = T["Sales"].Value; ViewData["Lead"] = T["Retail counter: packed atta, oil, Khal and other stock."].Value; var l = (Chakki.Web.Controllers.StockLists)ViewBag.Lists; }
<div class="row g-3">
  <div class="col-lg-8"><div class="card">
    @if (Model.Count == 0) { <div class="ca-empty"><i class="bi bi-cart"></i>@T["No sales yet."]</div> }
    else
    {
      <div class="ca-table-wrap"><table class="table">
        <thead><tr><th>@T["Date"]</th><th>@T["Item"]</th><th>@T["Customer"]</th><th class="num">@T["Quantity"]</th><th class="num">@T["Amount"]</th><th class="num">@T["Margin"]</th><th>@T["Payment"]</th></tr></thead>
        <tbody>@foreach (var s in Model) { <tr><td>@Fmt.Date(s.Date)</td><td>@Fmt.Name(s.Item)</td><td>@s.Customer?.Name</td><td class="num">@Fmt.Qty(s.Quantity) @s.Item!.Unit</td><td class="num">@Fmt.Rs(s.Amount + s.TaxAmount)@if (s.TaxAmount > 0) {<br><small class="text-body-secondary">@s.TaxName @Fmt.Rs(s.TaxAmount)</small>}</td><td class="num">@Fmt.Rs(s.Amount - s.CostAmount)</td><td>@(s.OnUdhaar ? T["Udhaar"] : T["Cash"])</td></tr> }</tbody>
      </table></div>
    }
  </div></div>
  <div class="col-lg-4"><div class="card"><div class="card-header"><h2 class="card-title">@T["New sale"]</h2></div><div class="card-body">
    <form asp-antiforgery="true" method="post" action="/sales">
      <label class="form-label" for="si">@T["Item"]</label><select class="form-select mb-2" id="si" name="itemId">@foreach (var i in l.Items.Where(i => i.Quantity > 0)) { <option value="@i.Id">@Fmt.Name(i) — @Fmt.Qty(i.Quantity) @i.Unit @@ @Fmt.Rs(i.SalePrice)</option> }</select>
      <div class="row g-2 mb-2"><div class="col-6"><label class="form-label" for="sq">@T["Quantity"]</label><input class="form-control" id="sq" name="quantity" type="number" step="0.01" min="0.01" required inputmode="decimal"></div>
        <div class="col-6"><label class="form-label" for="sr">@T["Rate (optional)"]</label><input class="form-control" id="sr" name="rate" type="number" step="0.01" min="0" inputmode="decimal"></div></div>
      <label class="form-label" for="sc">@T["Customer (optional)"]</label><select class="form-select mb-2" id="sc" name="customerId"><option value="">@T["Walk-in"]</option>@foreach (var c in l.Customers) { <option value="@c.Id">@c.Name</option> }</select>
      <div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="su" name="onUdhaar" value="true"><label class="form-check-label" for="su">@T["Add to customer's Udhaar"]</label></div>
      <button class="btn btn-primary w-100">@T["Save sale"]</button>
    </form>
  </div></div></div>
</div>
