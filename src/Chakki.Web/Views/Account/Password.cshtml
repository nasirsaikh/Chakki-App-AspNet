@{ ViewData["Title"] = T["Change password"].Value; }
<div class="card" style="max-width:30rem"><div class="card-body">
  <form asp-antiforgery="true" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <div class="mb-3"><label class="form-label" for="current">@T["Current password"]</label><input class="form-control" id="current" name="current" type="password" required autocomplete="current-password"></div>
    <div class="mb-3"><label class="form-label" for="next">@T["New password"]</label><input class="form-control" id="next" name="next" type="password" minlength="8" required autocomplete="new-password"></div>
    <button class="btn btn-primary" type="submit">@T["Save"]</button>
  </form>
</div></div>
